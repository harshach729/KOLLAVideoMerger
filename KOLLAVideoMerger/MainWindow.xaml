<Window x:Class="KOLLAVideoMerger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KOLLA Video Merger"
        Height="900"
        Width="1150"
        MinHeight="750"
        MinWidth="950">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <TextBlock Grid.Row="0"
                   Text="KOLLA Video Merger"
                   FontSize="30"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- INPUT FOLDER -->

        <Grid Grid.Row="1"
              Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Input Folder:"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Margin="0,0,10,0"/>

            <TextBox x:Name="InputFolderTextBox"
                     Grid.Column="1"
                     Height="35"
                     VerticalContentAlignment="Center"
                     IsReadOnly="True"/>

            <Button Grid.Column="2"
                    Content="Browse..."
                    Width="100"
                    Height="35"
                    Margin="10,0,0,0"
                    Click="BrowseInputFolder_Click"/>

        </Grid>

        <!-- VIDEO LIST -->

        <GroupBox Grid.Row="2"
                  Header="DashCam Videos"
                  Margin="0,0,0,15">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="VideoCountText"
                           Text="No videos selected"
                           Margin="10"
                           FontWeight="SemiBold"/>

                <ListView x:Name="VideoListView"
                          Grid.Row="1"
                          Margin="10"
                          SelectionMode="Extended">

                    <ListView.View>

                        <GridView>

                            <GridViewColumn Header="#"
                                            Width="50"
                                            DisplayMemberBinding="{Binding Number}"/>

                            <GridViewColumn Header="File Name"
                                            Width="400"
                                            DisplayMemberBinding="{Binding FileName}"/>

                            <GridViewColumn Header="Size"
                                            Width="100"
                                            DisplayMemberBinding="{Binding FileSize}"/>

                            <GridViewColumn Header="Duration"
                                            Width="100"
                                            DisplayMemberBinding="{Binding DurationText}"/>

                            <GridViewColumn Header="Resolution"
                                            Width="120"
                                            DisplayMemberBinding="{Binding Resolution}"/>

                            <GridViewColumn Header="FPS"
                                            Width="70"
                                            DisplayMemberBinding="{Binding FrameRate}"/>

                            <GridViewColumn Header="Video"
                                            Width="90"
                                            DisplayMemberBinding="{Binding VideoCodec}"/>

                            <GridViewColumn Header="Audio"
                                            Width="90"
                                            DisplayMemberBinding="{Binding AudioCodec}"/>

                        </GridView>

                    </ListView.View>

                </ListView>

            </Grid>

        </GroupBox>

        <!-- AUDIO -->

        <GroupBox Grid.Row="3"
                  Header="Music / Audio"
                  Margin="0,0,0,15">

            <Grid Margin="15">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- SOURCE -->

                <TextBlock Grid.Row="0"
                           Text="Source:"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            Orientation="Horizontal">

                    <RadioButton x:Name="NoAudioRadioButton"
                                 Content="None"
                                 IsChecked="True"
                                 Margin="0,0,20,0"
                                 Checked="AudioSource_Checked"/>

                    <RadioButton x:Name="LocalAudioRadioButton"
                                 Content="Local File"
                                 Margin="0,0,20,0"
                                 Checked="AudioSource_Checked"/>

                    <RadioButton x:Name="YouTubeAudioRadioButton"
                                 Content="YouTube"
                                 Checked="AudioSource_Checked"/>

                </StackPanel>

                <!-- LOCAL -->

                <TextBox x:Name="LocalAudioTextBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         Height="32"
                         Margin="0,8,10,0"
                         IsEnabled="False"/>

                <Button x:Name="BrowseAudioButton"
                        Grid.Row="1"
                        Grid.Column="2"
                        Content="Browse..."
                        Height="32"
                        Margin="0,8,0,0"
                        IsEnabled="False"
                        Click="BrowseAudioButton_Click"/>

                <!-- YOUTUBE -->

                <TextBox x:Name="YouTubeUrlTextBox"
                         Grid.Row="2"
                         Grid.Column="1"
                         Height="32"
                         Margin="0,8,10,0"
                         IsEnabled="False"
                         ToolTip="Paste a YouTube video URL"/>

                <Button x:Name="FetchYouTubeButton"
                        Grid.Row="2"
                        Grid.Column="2"
                        Content="Fetch Audio"
                        Height="32"
                        Margin="0,8,0,0"
                        IsEnabled="False"
                        Click="FetchYouTubeButton_Click"/>

                <!-- TRIM -->

                <TextBlock Grid.Row="3"
                           Text="Music Start / End:"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,10,0,0"/>

                <StackPanel Grid.Row="3"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="0,10,0,0">

                    <TextBox x:Name="MusicStartTextBox"
                             Width="80"
                             Height="30"
                             Text="00:00"
                             Margin="0,0,10,0"/>

                    <TextBlock Text="to"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <TextBox x:Name="MusicEndTextBox"
                             Width="80"
                             Height="30"
                             Text="00:00"/>

                </StackPanel>

                <!-- POSITION -->

                <TextBlock Grid.Row="4"
                           Text="Music Position:"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,10,0,0"/>

                <TextBox x:Name="MusicPositionTextBox"
                         Grid.Row="4"
                         Grid.Column="1"
                         Width="80"
                         Height="30"
                         HorizontalAlignment="Left"
                         Text="00:00"
                         Margin="0,10,0,0"/>

                <!-- MIX -->

                <StackPanel Grid.Row="5"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="0,10,0,0">

                    <TextBlock Text="Mode:"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Margin="0,0,10,0"/>

                    <ComboBox x:Name="AudioMixModeComboBox"
                              Width="100"
                              Height="30"
                              SelectedIndex="0">

                        <ComboBoxItem Content="Mix"/>
                        <ComboBoxItem Content="Replace"/>

                    </ComboBox>

                    <TextBlock Text="Music:"
                               VerticalAlignment="Center"
                               Margin="30,0,5,0"/>

                    <Slider x:Name="MusicVolumeSlider"
                            Width="100"
                            Minimum="0"
                            Maximum="1"
                            Value="0.35"/>

                    <TextBlock Text="{Binding ElementName=MusicVolumeSlider, Path=Value, StringFormat={}{0:P0}}"
                               Width="45"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="Original:"
                               VerticalAlignment="Center"
                               Margin="20,0,5,0"/>

                    <Slider x:Name="OriginalVolumeSlider"
                            Width="100"
                            Minimum="0"
                            Maximum="1"
                            Value="1"/>

                    <TextBlock Text="{Binding ElementName=OriginalVolumeSlider, Path=Value, StringFormat={}{0:P0}}"
                               Width="45"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </GroupBox>

        <!-- OPTIONS -->

        <GroupBox Grid.Row="4"
                  Header="Output Options"
                  Margin="0,0,0,15">

            <StackPanel Margin="15"
                        Orientation="Horizontal">

                <CheckBox x:Name="AudioCheckBox"
                          Content="Include original audio"
                          IsChecked="True"
                          FontSize="15"
                          Margin="0,0,30,0"/>

                <CheckBox x:Name="EnhancementCheckBox"
                          Content="Automatically enhance video"
                          IsChecked="True"
                          FontSize="15"
                          Margin="0,0,30,0"/>

                <CheckBox x:Name="FastModeCheckBox"
                          Content="Use fast processing when possible"
                          IsChecked="True"
                          FontSize="15"/>

            </StackPanel>

        </GroupBox>

        <!-- BOTTOM -->

        <Grid Grid.Row="5">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ProgressBar x:Name="ProgressBar"
                         Height="25"
                         Minimum="0"
                         Maximum="100"
                         VerticalAlignment="Center"/>

            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Margin="10"
                       Text="Ready"/>

            <Button x:Name="MergeButton"
                    Grid.Column="1"
                    Content="MERGE VIDEOS"
                    Width="160"
                    Height="45"
                    Margin="10,0"
                    Click="MergeButton_Click"/>

            <Button x:Name="CancelButton"
                    Grid.Column="2"
                    Content="CANCEL"
                    Width="100"
                    Height="45"
                    IsEnabled="False"
                    Click="CancelButton_Click"/>

        </Grid>

    </Grid>

</Window>